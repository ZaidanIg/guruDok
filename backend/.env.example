# GuruDok Backend Environment Configurations

# Application
APP_NAME=GuruDok API
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://gurudok.guru"]

# PostgreSQL Database (Local GuruDocDB)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=GuruDocDB
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DATABASE_URL=postgresql://postgres:your_db_password_here@127.0.0.1:5432/GuruDocDB

# Security & Limits
MAX_REQUEST_BODY_SIZE=2097152 # 2 MB in bytes
RATE_LIMIT_PER_MINUTE=60

# Master Dataset & File Storage
DATASET_PATH=../document/dataset
GENERATED_DIR=./generated_docs
STORAGE_DRIVER=local # local | s3

# Cloudflare R2 / S3 Credentials (Opsional pada development)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gurudok-documents
R2_PUBLIC_URL=https://files.gurudok.guru
