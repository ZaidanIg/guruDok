# ==============================================================================
# Contoh Environment Variables untuk Staging Coolify + DuckDNS
# Salin variabel ini ke menu "Environment Variables" di Dashboard Coolify
# ==============================================================================

# Database PostgreSQL (GuruDocDB)
DB_NAME=GuruDocDB
DB_USER=postgres
DB_PASSWORD=GantiDenganPasswordKuatStaging123!

# Domain DuckDNS Anda (untuk CORS Backend)
CORS_ORIGINS=https://gurudok-staging.duckdns.org

# Driver Penyimpanan ('local' untuk staging awal)
STORAGE_DRIVER=local

# Google OAuth & Download Auth Gate (Wajib untuk tombol Masuk dengan Google saat Download)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
JWT_SECRET_KEY=GantiDenganSecretAcakPanjangStaging2026!
AUTH_REQUIRED_FOR_DOWNLOAD=True

# Opsional: Hanya diperlukan jika mengaktifkan profile 'duckdns' (IP VPS dinamis)
DUCKDNS_SUBDOMAINS=gurudok-staging
DUCKDNS_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
